# scripts/macos/tts-api.sh 的配置（复制到 ~/tts-api-data/tts-api.env 再改）。每行 KEY=VALUE，原样作为 gateway 的环境变量。
# 各变量的含义见 Core README。按设备性能调整推理参数。
TTSAPI_GSV_ROOT=~/GPT-SoVITS
TTSAPI_DATA_DIR=~/tts-api-data/data
TTSAPI_WEIGHTS_DIR=~/tts-api-data/weights
TTSAPI_TRAIN_DIR=~/tts-api-data/training
TTSAPI_DATASET_ROOT=~/tts-api-data/datasets
# 默认只供本机访问；允许局域网连接时，改为指定私网地址或 0.0.0.0。
TTSAPI_HOST=127.0.0.1
# 设备：默认 auto（Apple Silicon 上是 mps）。v2pro / v2proplus 在 M6 的 CPU 上每句比 MPS 快 15–20%（GPT 逐 token 解码，
# MPS 每一步的调度开销大），v4 的 CFM 采样在 MPS 上快
TTSAPI_DEVICE_V2PRO=cpu
TTSAPI_DEVICE_V2PROPLUS=cpu
# 打分的说话人模型放 MPS 上每条只快 0.3 秒，进程却多占 4GB 多
TTSAPI_DEVICE_SCORER=cpu
# CPU 上 torch 的线程数：M6 上默认只开 2 个；4–6 最快，12 个（带上能效核）反而慢
TTSAPI_TORCH_THREADS=6
# 打分的 whisper（只能在 CPU 上跑）：int8 每条约 5 秒、进程约 2.7GB；float32 约 2.7 秒、约 4.8GB
TTSAPI_ASR_COMPUTE_TYPE=int8
TTSAPI_ASR_THREADS=6
# 新起 worker 前要求的系统可用内存（MB），不够先关最久没用的空闲 worker；空闲多少分钟后关 worker（释放内存）
TTSAPI_WORKER_MEM_MB=3000
TTSAPI_IDLE_UNLOAD_MIN=10
