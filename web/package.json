{
  "name": "tts-studio-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "gen:api": "openapi-typescript ../api/openapi.json -o src/api/schema.d.ts",
    "dev": "vite",
    "typecheck": "tsc -b",
    "test:blind": "node --experimental-strip-types --test e2e/blind-title.test.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint src",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.88.0",
    "typescript": "~5.9",
    "vite": "^8.3.4"
  }
}
